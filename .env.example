AUTH_SECRET=
AUTH_URL=

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth 未启用（当前仅 GitHub + 可选 Email magic link）
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

EMAIL_SERVER=
EMAIL_FROM=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI enrichment of extracted tokens (OpenAI-compatible; see src/ai-enrich.js)
# Without it extraction still works, but AI enhancement is skipped
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# Required on Vercel for live URL extraction (Playwright connects remotely)
BROWSERLESS_TOKEN=
# Local extraction without Browserless: point to a local Chrome binary
# (default fallback is /usr/bin/chromium)
# CHROMIUM_PATH=/path/to/chrome
# Optional overrides:
# BROWSERLESS_URL=wss://production-sfo.browserless.io
# BROWSERLESS_WS_ENDPOINT=wss://production-sfo.browserless.io/chromium/playwright

# Optional: shared Turso database (falls back to local refero.db via sql.js)
# TURSO_URL=libsql://xxx.turso.io
# TURSO_AUTH_TOKEN=
